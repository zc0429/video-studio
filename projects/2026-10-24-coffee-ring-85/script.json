      "min_duration_s": 5,
      "pause_weight": 1
    },
    {
      "name": "环的诞生",
      "act": 3,
      "text": "水干了，圈留下。一九九七年，自然期刊发表论文，解释了这种颗粒搬运。",
      "keywords": [
        "圈留下",
        "一九九七年",
        "搬运"
      ],
      "min_duration_s": 0,
      "pause_weight": 1,
      "gap_ms": 220
    },
    {
      "name": "威士忌反转",
      "act": 3,
      "text": "威士忌却能出现回流。表面张力差，加上其他成分，可能让沉积更均匀。",
      "keywords": [
        "威士忌",
        "回流",
        "更均匀"
      ],
      "min_duration_s": 0,
      "pause_weight": 1.5,
      "gap_ms": 220
    },
    {
      "name": "打印电子线路",
      "act": 3,
      "text": "控制咖啡环，能改善银墨水的沉积，让喷墨打印的电子线路更均匀。",
      "keywords": [
        "银墨水",
        "打印",
        "电子线路"
      ],
      "min_duration_s": 0,
      "pause_weight": 1,
      "gap_ms": 220
